# Base de datos (PostgreSQL por defecto en producción / Docker, SQLite async local como fallback)
DATABASE_URL=sqlite+aiosqlite:///./mcp_collector.db
# Para PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/mcp_hub

# Configuración del Servidor
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Clave opcional para autenticación o protección de ingesta
# MCP_API_KEY=
